#!/usr/bin/python3
"""Manual integration test launcher; requires explicit root authorization.

Not installed or exposed by the GUI until service authorization and crash
recovery have undergone independent review.
"""
import sys
from jatayu_update_manager.supervisor import start_supervised

if __name__ == '__main__':
    if len(sys.argv) not in (2, 3):
        sys.exit(2)
    try:
        identifier = start_supervised(sys.argv[1], sys.argv[2] if len(sys.argv) == 3 else '-')
    except (OSError, PermissionError, ValueError) as exc:
        print('Transaction not started: ' + str(exc), file=sys.stderr)
        sys.exit(1)
    print(identifier)
