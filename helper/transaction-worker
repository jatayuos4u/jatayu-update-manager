#!/usr/bin/python3
"""Root worker for opt-in systemd transaction prototype (not GUI-enabled)."""
import sys
from jatayu_update_manager.supervisor import run_worker


if __name__ == '__main__':
    if len(sys.argv) != 4:
        sys.exit(2)
    try:
        sys.exit(run_worker(*sys.argv[1:]))
    except (OSError, PermissionError, ValueError) as exc:
        print('Transaction refused: ' + str(exc), file=sys.stderr)
        sys.exit(2)
