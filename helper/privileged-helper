#!/usr/bin/python3
"""Polkit-protected APT actions. Only fixed commands; no shell interpretation."""
import os
import re
import subprocess
import sys
from jatayu_update_manager.transaction import parse_simulation, SimulationError

APT = '/usr/bin/apt-get'
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin',
       'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8',
       'DEBIAN_FRONTEND': 'noninteractive', 'HOME': '/root'}

def preview():
    command = [APT, '-s', '--no-remove', 'upgrade']
    result = subprocess.run(command, env=ENV, cwd='/', check=False,
                            capture_output=True, text=True, timeout=120)
    if result.returncode:
        raise SimulationError('APT simulation failed: ' + result.stderr[-1000:])
    return parse_simulation(result.stdout)

def main(argv=None):
    args = sys.argv[1:] if argv is None else argv
    if os.geteuid() != 0:
        print('Administrator authorization required.', file=sys.stderr)
        return 1
    if args == ['refresh']:
        command = [APT, 'update', '-o', 'Dpkg::Use-Pty=0']
    elif len(args) == 2 and args[0] == 'upgrade' and re.fullmatch(r'[a-f0-9]{64}', args[1]):
        try:
            current = preview()
        except (OSError, subprocess.TimeoutExpired, SimulationError) as exc:
            print('Upgrade blocked: ' + str(exc), file=sys.stderr)
            return 3
        if current.digest != args[1]:
            print('APT upgrade plan changed since confirmation. Refresh and review again.', file=sys.stderr)
            return 4
        command = [APT, '-y', '--no-remove', 'upgrade',
                   '-o', 'Dpkg::Use-Pty=0',
                   '-o', 'Dpkg::Options::=--force-confold']
    else:
        print('Invalid action or transaction fingerprint.', file=sys.stderr)
        return 2
    try:
        return subprocess.run(command, env=ENV, cwd='/', check=False).returncode
    except OSError as exc:
        print(f'Cannot execute APT: {exc}', file=sys.stderr)
        return 1

if __name__ == '__main__':
    sys.exit(main())
